# The IPv6 block routed to this VPS. Replace the documentation prefix below.
R6P_IPV6_PREFIX=2001:db8:1234:5678::/64

# The proxy accepts clients over the VPS's IPv4 address by default.
R6P_LISTEN_ADDR=0.0.0.0:8080

# Authentication is mandatory unless explicitly disabled.
R6P_USERNAME=proxy-user
R6P_PASSWORD=replace-with-a-long-random-password

# Recommended: only accept your public client IP/CIDR. Comma-separated.
# R6P_ALLOWED_CLIENTS=198.51.100.10/32,2001:db8:abcd::10/128

# Exclude addresses already assigned to the VPS or reserved by the provider.
# R6P_EXCLUDE_IPV6=2001:db8:1234:5678::1,2001:db8:1234:5678::2

# Safe defaults. Set fallback to true only if non-rotating IPv4 egress is okay.
R6P_ALLOWED_PORTS=80,443
R6P_ALLOW_IPV4_FALLBACK=false
R6P_BLOCK_PRIVATE_TARGETS=true
R6P_MAX_CONNECTIONS=512
R6P_MAX_HEADER_BYTES=32768
R6P_HEADER_TIMEOUT_SECS=10
R6P_CONNECT_TIMEOUT_SECS=10
R6P_SHUTDOWN_GRACE_SECS=10

# RUST_LOG=rotating_ipv6_proxy=debug
